     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#API -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#API">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComponenteSoftware"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Analisis -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Analisis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ProcesoDesarrollo"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#BaseDatos -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#BaseDatos">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComponenteSoftware"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Bug -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Bug">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Defecto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Error"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Falla"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#CoberturaPruebas -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#CoberturaPruebas">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#MetricaCalidad"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComplejidadCodigo -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComplejidadCodigo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#MetricaCalidad"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComponenteSoftware -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComponenteSoftware">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#EntidadCalidadSoftware"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#tieneDefecto"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Defecto"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#lenguaje"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#nombre"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#numeroLineasCodigo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#tipo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Confiabilidad -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Confiabilidad">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#MetricaCalidad"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Defecto -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#Defecto">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#EntidadCalidadSoftware"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#afectaA"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/calidad_software.owl#ComponenteSoftware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
