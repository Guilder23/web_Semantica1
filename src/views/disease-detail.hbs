<article>
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card mb-3">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">Resumen</h2>
        </div>
        <ul class="list-group list-group-flush">
          {{#if disease.label}}
            <li class="list-group-item"><strong>Nombre:</strong> {{disease.label}}</li>
          {{/if}}
          {{#if disease.tipo}}
            <li class="list-group-item"><strong>Tipo:</strong> {{disease.tipo}}</li>
          {{/if}}
          {{#if disease.estado}}
            <li class="list-group-item"><strong>Estado:</strong> {{disease.estado}}</li>
          {{/if}}
          {{#if disease.prioridad}}
            <li class="list-group-item"><strong>Prioridad:</strong> {{disease.prioridad}}</li>
          {{/if}}
          {{#if disease.severidad}}
            <li class="list-group-item"><strong>Severidad:</strong> {{disease.severidad}}</li>
          {{/if}}
        </ul>
      </div>
      
      <div class="card mb-3">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">Propiedades</h2>
        </div>
        <ul class="list-group list-group-flush">
          {{#if disease.lenguaje}}
            <li class="list-group-item">
              <strong>Lenguaje:</strong> {{disease.lenguaje}}
            </li>
          {{/if}}
          {{#if disease.version}}
            <li class="list-group-item">
              <strong>Version:</strong> {{disease.version}}
            </li>
          {{/if}}
          {{#if disease.nombreEntorno}}
            <li class="list-group-item">
              <strong>Entorno:</strong> {{disease.nombreEntorno}}
            </li>
          {{/if}}
          {{#if disease.nombreMetrica}}
            <li class="list-group-item">
              <strong>Métrica:</strong> {{disease.nombreMetrica}}
            </li>
          {{/if}}
          {{#if disease.idDefecto}}
            <li class="list-group-item">
              <strong>Defecto:</strong> {{disease.idDefecto}}
            </li>
          {{/if}}
          {{#if disease.idRequerimiento}}
            <li class="list-group-item">
              <strong>Requerimiento:</strong> {{disease.idRequerimiento}}
            </li>
          {{/if}}
          {{#if disease.descripcion}}
            <li class="list-group-item">
              <strong>Descripción:</strong> {{disease.descripcion}}
            </li>
          {{/if}}
        </ul>
      </div>
    </div>
    
    <div class="col-md-8">
      <h1 class="mb-3">{{disease.label}}</h1>
      
      <div class="mb-4">
        <h2 class="h4">Descripción</h2>
        <p>{{disease.descripcion}}</p>
      </div>
      
      <div class="d-flex justify-content-between">
        <a href="/search?q={{encodeURI disease.label}}" class="btn btn-outline-secondary">
          Volver a resultados
        </a>
        <a href="{{disease.uri}}" class="btn btn-outline-primary" target="_blank" rel="noopener">
          Ver en RDF
        </a>
      </div>
    </div>
  </div>
</article>