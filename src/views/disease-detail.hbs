<article class="concept-detail">
  <div class="row g-4 align-items-start">
    <div class="col-md-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <p class="text-uppercase text-muted small mb-2">Concepto RDF</p>
          <h2 class="h3 mb-3">{{concept.label}}</h2>
          {{#if concept.description}}
            <p class="text-muted mb-4">{{concept.description}}</p>
          {{/if}}

          {{#if concept.types.length}}
            <div class="mb-3">
              <h3 class="h6 text-uppercase text-muted">Tipo</h3>
              <div class="d-flex flex-wrap gap-2">
                {{#each concept.types}}
                  <span class="badge bg-primary-subtle text-primary">{{this}}</span>
                {{/each}}
              </div>
            </div>
          {{/if}}

          {{#if concept.parents.length}}
            <div class="mb-3">
              <h3 class="h6 text-uppercase text-muted">Relacionado con</h3>
              <div class="d-flex flex-wrap gap-2">
                {{#each concept.parents}}
                  <span class="badge bg-secondary-subtle text-secondary">{{this}}</span>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <a href="/search?q={{encodeURI concept.label}}" class="btn btn-outline-secondary w-100">
            Volver a resultados
          </a>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
              <p class="text-uppercase text-muted small mb-1">Detalles</p>
              <h1 class="h2 mb-0">{{concept.label}}</h1>
            </div>
            <a href="{{concept.uri}}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              Abrir URI
            </a>
          </div>
          {{#if concept.description}}
            <p class="lead mb-0">{{concept.description}}</p>
          {{else}}
            <p class="lead text-muted mb-0">No hay descripción disponible para este concepto.</p>
          {{/if}}
        </div>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h3 class="h5 mb-3">Propiedades adicionales</h3>
          {{#if concept.propertyEntries.length}}
            <div class="list-group list-group-flush">
              {{#each concept.propertyEntries}}
                <div class="list-group-item px-0">
                  <div class="fw-semibold text-capitalize">{{key}}</div>
                  <div class="text-muted">{{values}}</div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="text-muted mb-0">No hay propiedades adicionales registradas.</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</article>