<h1 class="results-title">
  {{#if (eq lang 'es')}}Resultados para "{{query}}"{{/if}}
  {{#if (eq lang 'en')}}Results for "{{query}}"{{/if}}
  {{#if (eq lang 'pt')}}Resultados para "{{query}}"{{/if}}
  {{#if (eq lang 'de')}}Ergebnisse für "{{query}}"{{/if}}
  {{#if (eq lang 'fr')}}Résultats pour "{{query}}"{{/if}}
</h1>

{{#if isEmpty}}
  <div class="no-results">
    {{#if (eq lang 'es')}}No se encontro informacion de calidad de software que coincida con tu busqueda.{{/if}}
    {{#if (eq lang 'en')}}No software quality information found matching your search.{{/if}}
    {{#if (eq lang 'pt')}}Nenhuma informacao de qualidade de software correspondente a sua pesquisa foi encontrada.{{/if}}
    {{#if (eq lang 'de')}}Keine Informationen zur Softwarequalitat gefunden, die Ihrer Suche entsprechen.{{/if}}
    {{#if (eq lang 'fr')}}Aucune information de qualite logicielle correspondant a votre recherche n a ete trouvee.{{/if}}
  </div>
{{else}}
  <div class="diseases-grid">
    {{#each diseases}}
      <div class="disease-card">
        <!-- Encabezado con el nombre del recurso -->
        <div class="disease-header">
          <h2 class="disease-title">{{label}}</h2>
        </div>

        <!-- Imagen (si existe) -->
        {{#if thumbnail}}
          <div class="disease-image-container">
            <img src="{{thumbnail}}" class="disease-image" alt="{{label}}" loading="lazy">
          </div>
        {{/if}}

        <!-- Cuerpo con descripción -->
        <div class="disease-body">
          {{#if tipo}}
            <div class="disease-tag genre-tag">
              <svg xmlns="http://www.w3.org/2000/svg" class="tag-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
              <span>{{tipo}}</span>
            </div>
          {{/if}}
          
          <p class="disease-abstract">{{truncate descripcion 2000}}</p>
          
          <!-- Detalles adicionales -->
          <div class="disease-details">
            {{#if estado}}
              <div class="detail-item">
                <svg xmlns="http://www.w3.org/2000/svg" class="detail-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-1a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v1h-3zM4.75 12.094A5.973 5.973 0 004 15v1H1v-1a3 3 0 013.75-2.906z" />
                </svg>
                <div class="detail-text">
                  <span class="detail-label">
                    {{#if (eq ../lang 'es')}}Estado{{/if}}
                    {{#if (eq ../lang 'en')}}State{{/if}}
                    {{#if (eq ../lang 'pt')}}Estado{{/if}}
                    {{#if (eq ../lang 'de')}}Status{{/if}}
                    {{#if (eq ../lang 'fr')}}Etat{{/if}}
                  </span>
                  <span class="detail-value">{{estado}}</span>
                </div>
              </div>
            {{/if}}
            
            {{#if prioridad}}
              <div class="detail-item">
                <svg xmlns="http://www.w3.org/2000/svg" class="detail-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                </svg>
                <div class="detail-text">
                  <span class="detail-label">
                    {{#if (eq ../lang 'es')}}Prioridad{{/if}}
                    {{#if (eq ../lang 'en')}}Priority{{/if}}
                    {{#if (eq ../lang 'pt')}}Prioridade{{/if}}
                    {{#if (eq ../lang 'de')}}Prioritat{{/if}}
                    {{#if (eq ../lang 'fr')}}Priorite{{/if}}
                  </span>
                  <span class="detail-value">{{prioridad}}</span>
                </div>
              </div>
            {{/if}}
            
            {{#if severidad}}
              <div class="detail-item">
                <svg xmlns="http://www.w3.org/2000/svg" class="detail-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M11.17 3a1 1 0 01.98 1l1.12 7.2a3 3 0 002.97 2.6h3.28a1 1 0 010 2h-3.28a5 5 0 01-4.95-4.3l-1.12-7.2H5a3 3 0 00-3 3v8a3 3 0 003 3h8a3 3 0 003-3v-3a1 1 0 112 0v3a5 5 0 01-5 5H5a5 5 0 01-5-5v-8a5 5 0 015-5h6.17z" clip-rule="evenodd" />
                </svg>
                <div class="detail-text">
                  <span class="detail-label">
                    {{#if (eq ../lang 'es')}}Severidad{{/if}}
                    {{#if (eq ../lang 'en')}}Severity{{/if}}
                    {{#if (eq ../lang 'pt')}}Severidade{{/if}}
                    {{#if (eq ../lang 'de')}}Schweregrad{{/if}}
                    {{#if (eq ../lang 'fr')}}Gravite{{/if}}
                  </span>
                  <span class="detail-value">{{severidad}}</span>
                </div>
              </div>
            {{/if}}
          </div>
        </div>

        <!-- Enlace a la página del enfermedad -->
        <div class="disease-footer">
          <h3 class="references-title">
            {{#if (eq ../lang 'es')}}Referencias{{/if}}
            {{#if (eq ../lang 'en')}}References{{/if}}
            {{#if (eq ../lang 'pt')}}Referências{{/if}}
            {{#if (eq ../lang 'de')}}Referenzen{{/if}}
            {{#if (eq ../lang 'fr')}}Références{{/if}}
          </h3>
          <div class="disease-links">
            {{#if lenguaje}}
              <a href="#" class="disease-link" aria-disabled="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="link-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                </svg>
                <span>Lenguaje: {{lenguaje}}</span>
              </a>
            {{/if}}
            {{#if version}}
              <a href="#" class="disease-link" aria-disabled="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="link-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                <span>Version: {{version}}</span>
              </a>
            {{/if}}
            {{#if uri}}
              <a href="/disease/{{encodeURI uri}}?lang={{../lang}}{{#if ../searchSource}}&source={{../searchSource}}{{/if}}" class="disease-link">
                <svg xmlns="http://www.w3.org/2000/svg" class="link-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                <span>
                  {{#if (eq ../lang 'es')}}Detalles{{/if}}
                  {{#if (eq ../lang 'en')}}Details{{/if}}
                  {{#if (eq ../lang 'pt')}}Detalhes{{/if}}
                  {{#if (eq ../lang 'de')}}Details{{/if}}
                  {{#if (eq ../lang 'fr')}}Détails{{/if}}
                </span>
              </a>
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{/if}}

<style>
  :root {
    --primary-color: #7c3aed;
    --accent: #06b6d4;
    --bg: #0b1220;
    --surface: #0f1724;
    --card-bg: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    --muted: #9aa4b2;
    --text: #e6eef8;
    --radius: 10px;
    --shadow: 0 10px 30px rgba(2,6,23,0.7);
    --transition: all 0.22s ease;
  }

  .results-title { color:var(--text); font-size:1.5rem; font-weight:700; margin-bottom:1rem; text-align:center }

  .no-results { text-align:center; padding:1.25rem; background:var(--surface); border-radius:var(--radius); box-shadow:var(--shadow); color:var(--muted); max-width:600px; margin:0 auto }

  .diseases-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; padding:1rem 0; background: transparent }

  .disease-card { background: #0f1724; border-radius:var(--radius); overflow:hidden; color:var(--text); transition:var(--transition); display:flex; flex-direction:column; border:1px solid rgba(255,255,255,0.04); padding:10px }
  .disease-card:hover { transform:translateY(-6px); box-shadow:var(--shadow) }

  .disease-header { padding:6px 8px }
  .disease-title { font-size:1.05rem; font-weight:600; margin:0; color:var(--text) }

  .disease-image-container { width:100%; overflow:hidden; margin:8px 0; background: rgba(255,255,255,0.02); border-radius:8px; display:flex; align-items:center; justify-content:center }
  .disease-image { width:100%; height:140px; object-fit:cover; border-radius:6px; background:#0b1220 }

  .disease-body { padding:6px 8px; flex-grow:1 }
  .disease-tag { display:inline-flex; align-items:center; padding:4px 8px; border-radius:999px; font-size:0.72rem; font-weight:600; margin-bottom:8px; background:rgba(124,58,237,0.12); color:var(--primary-color) }

  .disease-abstract { color:var(--muted); font-size:0.85rem; line-height:1.4; margin-bottom:10px }

  .disease-details { display:flex; flex-direction:column; gap:6px; margin-bottom:8px }
  .detail-item { display:flex; align-items:center; gap:8px }
  .detail-icon { width:16px; height:16px; color:var(--muted); flex-shrink:0 }
  .detail-label { font-size:0.72rem; color:var(--muted); text-transform:uppercase }
  .detail-value { font-size:0.88rem; color:var(--text); font-weight:600 }

  .disease-footer { padding:8px; background: transparent; border-top:1px solid rgba(255,255,255,0.02); display:flex; justify-content:space-between; align-items:center }
  .references-title { font-size:0.75rem; color:var(--muted); margin:0 }
  .disease-links { display:flex; gap:8px }
  .disease-link { display:inline-flex; align-items:center; gap:6px; padding:6px 8px; border-radius:8px; font-size:0.78rem; font-weight:600; color:var(--text); background:rgba(255,255,255,0.02); text-decoration:none }
  .disease-link:hover { background:rgba(255,255,255,0.03) }
  .link-icon { width:14px; height:14px }

  @media (max-width: 768px) { .diseases-grid { grid-template-columns: 1fr } .results-title { font-size:1.25rem } }
</style>