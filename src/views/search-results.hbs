<h1 class="results-title">
  {{#if (eq lang 'es')}}Resultados para "{{query}}"{{/if}}
  {{#if (eq lang 'en')}}Results for "{{query}}"{{/if}}
  {{#if (eq lang 'pt')}}Resultados para "{{query}}"{{/if}}
  {{#if (eq lang 'de')}}Ergebnisse für "{{query}}"{{/if}}
  {{#if (eq lang 'fr')}}Résultats pour "{{query}}"{{/if}}
</h1>

{{#if isEmpty}}
  <div class="no-results">
    {{#if (eq lang 'es')}}No hay coincidencias para "{{query}}" en temas de calidad de software.{{/if}}
    {{#if (eq lang 'en')}}No matches found for "{{query}}" in software quality topics.{{/if}}
    {{#if (eq lang 'pt')}}Não há coincidências para "{{query}}" em temas de qualidade de software.{{/if}}
    {{#if (eq lang 'de')}}Keine Treffer für "{{query}}" in Themen zur Softwarequalität gefunden.{{/if}}
    {{#if (eq lang 'fr')}}Aucune correspondance trouvée pour "{{query}}" dans les sujets de qualité logicielle.{{/if}}
  </div>
{{else}}
  <div class="diseases-grid">
    {{#each diseases}}
      <div class="disease-card">
        <!-- Encabezado con el nombre del recurso -->
        <div class="disease-header">
          <h2 class="disease-title">{{label}}</h2>
        </div>

        {{#if thumbnail}}
          <div class="disease-image-container">
            <img src="{{thumbnail}}" class="disease-image" alt="{{label}}" loading="lazy">
          </div>
        {{/if}}

        <div class="disease-body">
          {{#if typeName}}
            <div class="disease-tag genre-tag">
              <svg xmlns="http://www.w3.org/2000/svg" class="tag-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
              <span>{{typeName}}</span>
            </div>
          {{/if}}
          
          <p class="disease-abstract">{{truncate abstract 2000}}</p>
          {{#if dbpediaPage}}
            <p class="disease-abstract mb-0">DBpedia: <a href="{{dbpediaPage}}" target="_blank" rel="noopener noreferrer">{{dbpediaPage}}</a></p>
          {{/if}}
        </div>

        <div class="disease-footer">
          <h3 class="references-title">
            {{#if (eq lang 'es')}}Referencias{{/if}}
            {{#if (eq lang 'en')}}References{{/if}}
            {{#if (eq lang 'pt')}}Referências{{/if}}
            {{#if (eq lang 'de')}}Referenzen{{/if}}
            {{#if (eq lang 'fr')}}Références{{/if}}
          </h3>
          <div class="disease-links">
            {{#if dbpediaPage}}
              <a href="{{dbpediaPage}}" class="disease-link" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" class="link-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                <span>DBPedia</span>
              </a>
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{/if}}

<style>
  :root {
    --primary-color: #4f46e5;
    --secondary-color: #6366f1;
    --text-color: #1f2937;
    --light-text: #6b7280;
    --bg-color: #f9fafb;
    --card-bg: #ffffff;
    --border-color: #e5e7eb;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --radius: 12px;
    --transition: all 0.3s ease;
  }

  .results-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 2rem;
    text-align: center;
  }

  .no-results {
    text-align: center;
    padding: 2rem;
    background-color: var(--card-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--light-text);
    max-width: 600px;
    margin: 0 auto;
  }

  .diseases-grid {
    gap: 2rem;
    padding: 1rem 0;
  }

  .disease-card {
    background-color: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .disease-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .disease-header {
    padding: 1.5rem 1.5rem 0;
  }

  .disease-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-color);
    margin: 0;
  }

  .disease-image-container {
    width: 100%;
    overflow: hidden;
    margin: 1rem 0;
  }

  .disease-image {
    object-fit: cover;
    transition: var(--transition);
    display: flex;
margin: 0 auto;
  }

  .disease-card:hover .disease-image {
    transform: scale(1.05);
  }

  .disease-body {
    padding: 0 1.5rem;
    flex-grow: 1;
  }

  .disease-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 1rem;
    background-color: #e0e7ff;
    color: var(--primary-color);
  }

  .tag-icon {
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.25rem;
  }

  .disease-abstract {
    color: var(--light-text);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .disease-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .detail-icon {
    width: 1rem;
    height: 1rem;
    color: var(--light-text);
    flex-shrink: 0;
  }

  .detail-text {
    display: flex;
    flex-direction: column;
  }

  .detail-label {
    font-size: 0.75rem;
    color: var(--light-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-value {
    font-size: 0.875rem;
    color: var(--text-color);
    font-weight: 500;
  }

  .disease-footer {
    padding: 1rem 1.5rem;
    background-color: #f8f9fa;
    border-top: 1px solid var(--border-color);
  }

  .references-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--light-text);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .disease-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .disease-link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--primary-color);
    background-color: #e0e7ff;
    text-decoration: none;
    transition: var(--transition);
  }

  .disease-link:hover {
    background-color: #c7d2fe;
    color: #4338ca;
  }

  .link-icon {
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.375rem;
  }

  @media (max-width: 768px) {
    .diseases-grid {
      grid-template-columns: 1fr;
    }
    
    .results-title {
      font-size: 1.5rem;
    }
  }
</style>