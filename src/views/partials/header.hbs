<header class="site-header mb-2">
  <div class="container">
    <div class="header-bar">
      <a href="/" class="logo-link text-white text-decoration-none" aria-label="Ir al inicio">
        {{!-- <span class="brand-mark">CS</span> --}}
        <span class="brand-text">Calidad de Software</span>
      </a>

      <div class="header-search">
        {{> search-form }}
      </div>

      <div class="header-lang">
        {{> language-selector }}
      </div>
    </div>
  </div>

  <style>
    .site-header {
      background: linear-gradient(180deg, rgba(8,10,14,0.96), rgba(10,14,20,0.92));
      border-bottom: 1px solid rgba(255,255,255,0.06);
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    }

    .header-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      min-height: 74px;
      padding: 0.65rem 0;
    }

    .logo-link {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      white-space: nowrap;
      flex: 0 0 auto;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #7c3aed, #06b6d4);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      box-shadow: 0 8px 20px rgba(124,58,237,0.25);
      flex-shrink: 0;
    }

    .brand-text {
      font-size: 0.98rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      color: #f8fbff;
    }

    .header-search {
      flex: 1 1 auto;
      display: flex;
      justify-content: center;
      min-width: 0;
    }

    .header-search .search-form-improved {
      width: 100%;
    }

    .header-search .search-container {
      max-width: 680px;
    }

    .header-lang {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    .site-header .search-form-improved.compact {
      margin: 0;
    }

    @media (max-width: 992px) {
      .header-bar {
        gap: 0.75rem;
      }

      .brand-text {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .header-bar {
        min-height: auto;
        flex-wrap: wrap;
        padding: 0.7rem 0 0.85rem;
      }

      .header-search {
        order: 3;
        flex-basis: 100%;
      }

      .header-lang {
        margin-left: auto;
      }
    }
  </style>
</header>