<header class="site-header mb-2">
  <div class="container position-relative">
    <div class="d-flex align-items-center justify-content-between" style="padding: 0.5rem 0;">
      <a href="/" class="logo-link text-white text-decoration-none">
        <span class="h6 mb-0" style="font-size: 1rem;">Calidad de Software</span>
      </a>

      <div class="lang-top-right">
        {{> language-selector }}
      </div>
    </div>

    <div class="search-row" style="padding: 0.5rem 0;">
      <div class="d-flex justify-content-center">
        <div class="w-100" style="max-width:720px">{{> search-form }}</div>
      </div>
    </div>
  </div>

  <style>
    .site-header { 
      background: linear-gradient(180deg, rgba(8,10,14,0.95), rgba(14,16,20,0.96));
      padding: 0;
      border-bottom: 1px solid rgba(255,255,255,0.03);
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(6px);
    }

    .logo-link { display:flex; align-items:center; gap:8px; color:#ffffff; font-weight:600 }

    .lang-top-right { position: absolute; top: 8px; right: 12px; }

    .site-header { box-shadow: none; }
  </style>
</header>