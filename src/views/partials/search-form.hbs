<form action="/search" method="get" class="search-form-improved compact">
  <div class="search-wrapper">
    <div class="search-container">
      <input 
        type="search" 
        name="q" 
        value="{{query}}" 
        class="search-input" 
        placeholder="{{t 'search_placeholder'}}"
        required
        aria-label="{{t 'search_placeholder'}}"
      >
      <input type="hidden" name="lang" value="{{lang}}">
      
      <div class="search-actions">
        <button type="submit" name="source" value="dbpedia" class="search-button search-button-primary icon-only" aria-label="Buscar DBpedia" title="Buscar en DBpedia">
          <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 0 0 1.48-5.34c-.47-2.78-2.79-5-5.59-5.34a6.505 6.505 0 0 0-7.27 7.27c.34 2.8 2.56 5.12 5.34 5.59a6.5 6.5 0 0 0 5.34-1.48l.27.28v.79l4.25 4.25c.41.41 1.08.41 1.49 0 .41-.41.41-1.08 0-1.49L15.5 14zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </button>

        <button type="submit" name="source" value="local" class="search-button search-button-secondary icon-only" aria-label="Buscar localmente" title="Buscar localmente">
          <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 0h7v7h-7v-7z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <style>
    .search-form-improved.compact { max-width: 100%; margin: 0 auto; }
    .search-wrapper { display: flex; justify-content: center; width: 100%; }
    .search-container { display:flex; align-items:center; gap:12px; width:100%; max-width:720px; flex-wrap:nowrap; }
    .search-input { flex:1; min-width:0; padding:10px 14px; border-radius:20px; border:1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.03); color:#e6eef8; font-size:0.95rem }
    .search-input::placeholder { color: rgba(230,238,248,0.6) }
    .search-input:focus { outline:none; box-shadow: 0 6px 20px rgba(3,7,18,0.6); border-color: rgba(110,231,183,0.12) }

    .search-actions { display:flex; gap:10px; align-items:center; margin:0; flex-shrink:0 }
    .search-button { display:inline-flex; align-items:center; justify-content:center; gap:0; padding:8px; border-radius:50%; min-height:36px; min-width:36px; font-size:0.9rem; box-shadow:none; border:1px solid rgba(255,255,255,0.04); flex-shrink:0 }
    .search-button-primary { background: linear-gradient(90deg,#6d28d9,#4c1d95); color:#fff }
    .search-button-secondary { background: linear-gradient(90deg,#0f766e,#0ea5a3); color:#fff }
    .search-button.icon-only .search-text { display:none }
    .search-button:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(2,6,23,0.6) }
    .search-icon { display:block }

    @media (max-width:576px){ 
      .search-container { flex-wrap:wrap; gap:8px; } 
      .search-actions { width:100%; justify-content:flex-start; order:3; }
      .search-input { width:100%; order:2; font-size:0.95rem } 
      .search-button { min-width:40px; padding:8px } 
    }
  </style>
</form>